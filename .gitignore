# PlatformIO build output (reproducible from source)
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Python
__pycache__/
*.pyc

# Synthetic / simulated material is regenerated by the tools and is never evidence
data/synthetic/
data/sim/
evidence/sim/

# Vendor reference documents: fetched for verification, redistributed only by link
# (see docs/hardware/reference/README.md for URLs and SHA-256 sums)
docs/hardware/reference/*.pdf
docs/hardware/reference/*.png

# Flash backups read from the board (may contain earlier firmware / identifiers)
evidence/hardware/**/flash_backup*.bin

# Local secrets must never be committed
.env
*.key
secrets*

# Private agent instructions must never be published
CLAUDE.md
claude.md
